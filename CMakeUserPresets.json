{
  "version": 4,
  "configurePresets": [
    {
      "name": "x64-windows-cuda-vulkan-release",
      "inherits": [ "base", "reldbg" ],
      "cacheVariables": {
        "GGML_CUDA": "ON",
        "GGML_VULKAN": "ON",
        "CMAKE_CUDA_COMPILER": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.3/bin/nvcc.exe",
        "CMAKE_CUDA_ARCHITECTURES": "89-real",
        "CMAKE_MSVC_DEBUG_INFORMATION_FORMAT": "Embedded",
        "GGML_CUDA_FA": "ON",
        "GGML_CUDA_FA_ALL_QUANTS": "ON",
        "GGML_CUDA_KVARN": "ON",
        "GGML_CUDA_GRAPHS": "ON",
        "GGML_CUDA_COMPRESSION_MODE": "size",
        "GGML_CPU_ALL_VARIANTS": "ON",
        "GGML_BACKEND_DL": "ON",
        "LLAMA_LLGUIDANCE": "ON",
        "OPENSSL_ROOT_DIR": "C:/Program Files/OpenSSL-Win64"
      }
    },
    {
      "name": "x64-windows-cuda-vulkan-release-opt",
      "inherits": [ "base", "release" ],
      "description": "Maximum-performance Release build (no debug info, /O2 /Ob2). Use for shipped binaries.",
      "cacheVariables": {
        "GGML_CUDA": "ON",
        "GGML_VULKAN": "ON",
        "CMAKE_CUDA_COMPILER": "C:/Program Files/NVIDIA GPU Computing Toolkit/CUDA/v13.3/bin/nvcc.exe",
        "CMAKE_CUDA_ARCHITECTURES": "89-real",
        "GGML_CUDA_FA": "ON",
        "GGML_CUDA_FA_ALL_QUANTS": "ON",
        "GGML_CUDA_KVARN": "ON",
        "GGML_CUDA_GRAPHS": "ON",
        "GGML_CUDA_COMPRESSION_MODE": "size",
        "GGML_CPU_ALL_VARIANTS": "ON",
        "GGML_BACKEND_DL": "ON",
        "LLAMA_LLGUIDANCE": "ON",
        "OPENSSL_ROOT_DIR": "C:/Program Files/OpenSSL-Win64",
        "GGML_NATIVE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64-windows-cuda-vulkan-release",
      "configurePreset": "x64-windows-cuda-vulkan-release",
      "targets": [ "llama-server", "llama-lab" ],
      "jobs": 8
    },
    {
      "name": "x64-windows-cuda-vulkan-release-opt",
      "configurePreset": "x64-windows-cuda-vulkan-release-opt",
      "targets": [ "llama-server", "llama-lab" ],
      "jobs": 8
    }
  ]
}